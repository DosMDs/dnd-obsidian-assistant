# D&D Session Assistant — machine-local settings example (CFG-00/CFG-01).
#
# This file is a TEMPLATE. Copy it to the root of the dnd-assistant project as
# `.env` and edit the copy. Never commit a real .env or real provider secrets.
#
# Dotenv selection:
#   DND_ENV_FILE set -> that explicit absolute path is used
#   otherwise        -> <nearest enclosing dnd-assistant project root>/.env
# The project root is the first directory at or above the current working
# directory whose pyproject.toml declares [project].name = "dnd-assistant".
# Running outside a project checkout requires DND_ENV_FILE; the former
# platformdirs/%APPDATA%/~/.config default is no longer used.
#
# Precedence: explicit --config > process environment > this dotenv > defaults.
# DND_ENV_FILE is a bootstrap selector read only from the real process
# environment; it must be an absolute path and cannot be set from this file.

# Absolute path to the machine-local model-profile TOML containing [profiles.*].
# Used when a command is invoked without an explicit --config.
DND_MODEL_CONFIG_PATH=/absolute/path/to/models.toml

# DeepSeek provider credential. Only required for DeepSeek model profiles;
# local Ollama-only usage does not need it. Never commit a real key.
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-key
