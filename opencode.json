{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "build",
  "subagent_depth": 1,
  "lsp": true,
  "agent": {
    "plan": {
      "description": "Read-only planning and analysis. Cannot mutate repository state.",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "edit": "deny",
        "todowrite": "deny",
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git branch": "allow",
          "git branch --list": "allow",
          "git branch --show-current": "allow",
          "git branch --merged": "allow",
          "git branch --no-merged": "allow",
          "git branch -l": "allow",
          "git branch -a": "allow",
          "git branch -r": "allow",
          "git branch -v": "allow",
          "git ls-files*": "allow",
          "git worktree list*": "allow",
          "git log*--output*": "deny",
          "git diff*--output*": "deny",
          "git show*--output*": "deny"
        },
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow"
        }
      }
    },
    "build": {
      "description": "Default implementation agent. Makes scoped repository changes and runs development commands; finalization only when the Task Contract authorizes it.",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "edit": "allow",
        "todowrite": "allow",
        "external_directory": "ask",
        "webfetch": "allow",
        "websearch": "ask",
        "bash": {
          "*": "ask",

          "uv": "allow",
          "uv *": "allow",
          "python --version*": "allow",

          "pwd": "allow",
          "cd": "allow",
          "cd *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "dir": "allow",
          "dir *": "allow",
          "Get-ChildItem*": "allow",
          "Get-Location*": "allow",
		  "Get-FileHash *": "allow",
		  "Get-Item *": "allow",
		  "Write-Output *": "allow",
		  "Measure-Object *": "allow",
		  "Select-Object *": "allow",
          "tree*": "allow",
          "where*": "allow",
          "which*": "allow",
          "Get-Command*": "allow",
		  "echo": "allow",
		  "echo *": "allow",

          "rg *": "allow",
          "grep *": "allow",
          "findstr *": "allow",
          "Select-String*": "allow",

          "mkdir *": "allow",
          "New-Item -ItemType Directory*": "allow",

          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git rev-parse": "allow",
          "git rev-parse *": "allow",
          "git ls-files": "allow",
          "git ls-files *": "allow",
          "git worktree list": "allow",
          "git worktree list *": "allow",
		  "git merge-base": "allow",
		  "git merge-base *": "allow",
		  "git rev-list": "allow",
		  "git rev-list *": "allow",
		  "git checkout": "allow",
		  "git checkout *": "allow",

          "git branch": "allow",
          "git branch --list": "allow",
          "git branch --show-current": "allow",
          "git branch --merged": "allow",
          "git branch --no-merged": "allow",
          "git branch -l": "allow",
          "git branch -a": "allow",
          "git branch -r": "allow",
          "git branch -v": "allow",

          "git tag --list": "allow",
          "git tag -l": "allow",
          "git remote -v*": "allow",
          "git remote show*": "allow",
          "git config --get*": "allow",
          "git config --list*": "allow",
          "git blame*": "allow",
          "git shortlog*": "allow",
          "git describe*": "allow",
          "git stash list*": "allow",
          "git reflog": "allow",
          "git reflog show*": "allow",

          "git fetch": "allow",
          "git fetch *": "allow",
          "git pull --ff-only*": "allow",
          "git merge --ff-only*": "allow",

          "git add": "allow",
          "git add *": "allow",
          "git commit": "allow",
          "git commit *": "allow",
          "git push": "allow",
          "git push *": "allow",

          "git push *-?*f*": "ask",
          "git fetch *-?*f*": "ask",

          "git fetch *+*": "deny",
          "git fetch*--update-head-ok*": "deny",
          "git fetch*--force*": "deny",
          "git fetch* -f*": "deny",

          "git push --force*": "deny",
          "git push * --force*": "deny",
          "git push --force-with-lease*": "deny",
          "git push * --force-with-lease*": "deny",
          "git push -f*": "deny",
          "git push * -f*": "deny",
          "git push --mirror*": "deny",
          "git push * --mirror*": "deny",
          "git push --prune*": "deny",
          "git push * --prune*": "deny",
          "git push --delete*": "deny",
          "git push * --delete*": "deny",
          "git push * :*": "deny",
          "git push * +*": "deny",

          "git reset --hard*": "deny",
          "git clean*": "deny",
          "git filter-branch*": "deny",

          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch --delete*": "deny",
          "git branch * -d*": "deny",
          "git branch * -D*": "deny",
          "git branch * --delete*": "deny",

          "git tag -d*": "deny",
          "git tag -D*": "deny",
          "git tag --delete*": "deny",
          "git tag * -d*": "deny",
          "git tag * -D*": "deny",
          "git tag * --delete*": "deny",

          "git worktree remove*": "deny",
          "git worktree prune*": "deny",
          "git stash drop*": "deny",
          "git stash clear*": "deny",

          "rm -r*": "deny",
          "rm -R*": "deny",
          "rm -fr*": "deny",
          "rm -fR*": "deny",
          "rm -Fr*": "deny",
          "rm -FR*": "deny",
          "rm * -r*": "deny",
          "rm * -R*": "deny",
          "rm -force*": "deny",
          "rm --force*": "deny",
          "rm --recursive*": "deny",
          "Remove-Item*-Recurse*": "deny",
          "Remove-Item*-Force*": "deny",
          "del */s*": "deny",
          "erase */s*": "deny",
          "rd */s*": "deny",
          "rmdir */s*": "deny",

          "format": "deny",
          "format *": "deny",
          "diskpart*": "deny",
          "Format-Volume*": "deny",
          "Clear-Disk*": "deny",
          "Initialize-Disk*": "deny",
          "shutdown*": "deny",
          "Restart-Computer*": "deny",
          "Stop-Computer*": "deny"
        },
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "test-evidence-reviewer": "allow",
          "final-diff-reviewer": "allow"
        }
      }
    }
  }
}
